# Copy to .env and fill in to enable a TURN relay (needed when STUN alone can't connect two networks).
# TURN_URL can list several URLs separated by commas.
TURN_URL=turn:your-turn-server.example.com:3478,turns:your-turn-server.example.com:443?transport=tcp
TURN_USERNAME=
TURN_CREDENTIAL=

# Supabase (step 6: groups + leaderboard). Server only — never put these in browser code.
# Project Settings → API: the Project URL and the service_role key.
# Leave empty to keep groups in memory (fine for local testing; resets on restart).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
