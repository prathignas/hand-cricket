# Copy to .env for local runs. On Render, set these under the service's Environment tab.
# Every value can stay empty locally.

# Port to listen on. Render sets this itself; locally it defaults to 3000.
PORT=

# Set to "production" on Render. Turns off ?dev=1 keyboard mode so nobody can type their numbers.
NODE_ENV=

# TURN relay (needed when STUN alone can't connect two networks).
# TURN_URL can list several URLs separated by commas, e.g.
# turn:relay.example.com:80,turn:relay.example.com:443,turns:relay.example.com:443?transport=tcp
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Supabase (groups + leaderboard). Server only — never put these in browser code.
# Project Settings → API: the Project URL and the service_role key.
# Leave empty to keep groups in memory (fine for local testing; resets on restart).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Only for the Playwright scripts (npm run test:e2e). Defaults to http://localhost:3123.
BASE_URL=
